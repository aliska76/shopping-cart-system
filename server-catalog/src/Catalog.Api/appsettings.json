{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "CatalogDb": ""
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Catalog": {
    "UseInMemoryStore": false
  },
  "Caching": {
    "CategoriesTtlSeconds": 60
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "SegmentsPerWindow": 4,
    "QueueLimit": 0,
    "ConcurrencyPermitLimit": 50,
    "ConcurrencyQueueLimit": 0
  }
}
