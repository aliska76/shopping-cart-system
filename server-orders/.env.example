# Copy to .env (gitignored) and adjust if needed. Every value here already has a working
# default baked into src/config/configuration.ts, so a bare checkout runs with none of this
# set at all -- this file exists purely to document what's overridable.
PORT=3001
ELASTICSEARCH_NODE=http://localhost:9200
ORDERS_INDEX=orders
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_LIMIT=100
BODY_SIZE_LIMIT=1mb
MAX_CONCURRENT_REQUESTS=50
CORS_ALLOWED_ORIGINS=http://localhost:5173
